# Admin Service Configuration

# Service Port
ADMIN_SERVICE_PORT=8007

# Database
ADMIN_DB_URI=mongodb://localhost:27017/fieldtech_admin

# JWT Secret
SECRET_KEY=your_secret_key_change_in_production

# Other Service URLs (for admin dashboard aggregation)
