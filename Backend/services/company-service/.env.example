# Company Service Configuration

# Service Port
COMPANY_SERVICE_PORT=8009

# Database
COMPANY_DB_URI=mongodb://localhost:27017/fieldtech_company

# JWT Secret (should match auth service)
SECRET_KEY=your_secret_key_change_in_production

# Other Service URLs
AUTH_SERVICE_URL=http://localhost:8001
WORKORDER_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8004

# Frontend URL
FRONTEND_URL=http://localhost:5173

# API Gateway
API_GATEWAY_URL=http://localhost:8000

# File Upload (for company logos)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=fieldtech-uploads
